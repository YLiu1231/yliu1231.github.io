  <entry>
    <title>华为日记（二）</title>
    <link href="https://profile.yulin.love/2021/11/30/%E5%8D%8E%E4%B8%BA%E6%97%A5%E8%AE%B0%EF%BC%88%E4%BA%8C%EF%BC%89/"/>
